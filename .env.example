# MIKA AGENTIC OS - environment variable example
# Copy to .env.local and supply private values locally.
# Keep secrets, private URLs, account IDs, and machine paths out of Git.
#
# Conventions:
# - Required-for-feature: needed when that feature is enabled.
# - Optional: uses the documented application default when empty.
# - Reserved: capability metadata only; the current runtime does not read it.

# -------------------------------------------------------------------
# Application
# -------------------------------------------------------------------

# Optional: Next.js server port.
PORT=3099

# Optional: maximum age of adapter health evidence in milliseconds.
AGENT_HEALTH_MAX_AGE_MS=300000

# Optional: maximum age of activation preflight evidence in milliseconds.
ACTIVATION_PREFLIGHT_MAX_AGE_MS=300000

# Required for mutation APIs outside same-origin localhost development.
# Send as Authorization: Bearer <token>, X-Mika-Admin-Token, or through a
# secure httpOnly `mika_admin_token` cookie set by the local reverse proxy.
MIKA_ADMIN_TOKEN=

# Optional: comma-separated browser origins allowed to call mutation APIs.
# Same-origin requests are always included. Do not include a trailing slash.
MIKA_ALLOWED_ORIGINS=

# Optional: permits governed agent handoff where the existing route supports it.
AGENT_HANDOFF_ENABLED=false

# -------------------------------------------------------------------
# OpenClaw gateway
# -------------------------------------------------------------------

# Required for OpenClaw status and dispatch.
OPENCLAW_ENABLED=false
OPENCLAW_GATEWAY_URL=
OPENCLAW_API_TOKEN=

# Optional: separate OpenClaw control origin. Falls back to gateway URL.
OPENCLAW_CONTROL_URL=

# Optional: endpoint paths, timeouts, and model.
OPENCLAW_STATUS_PATH=/api/status
OPENCLAW_STATUS_TIMEOUT_MS=5000
OPENCLAW_TASK_PATH=/v1/chat/completions
OPENCLAW_TASK_TIMEOUT_MS=60000
OPENCLAW_MODEL=

# Optional legacy shared-config key. Prefer OPENCLAW_API_TOKEN for server routes.
OPENCLAW_API_KEY=

# Optional browser-visible gateway origins. Never place secrets in NEXT_PUBLIC_*.
NEXT_PUBLIC_VPS_GATEWAY_URL=
NEXT_PUBLIC_LOCAL_GATEWAY_URL=

# -------------------------------------------------------------------
# Paperclip external workspace
# -------------------------------------------------------------------

# Required for Paperclip when PAPERCLIP_ENABLED=true.
PAPERCLIP_ENABLED=false
PAPERCLIP_APP_URL=
PAPERCLIP_API_URL=
PAPERCLIP_COMPANY_ID=
PAPERCLIP_COMPANY_PATH=

# Optional: gallery refresh interval in milliseconds (5000-300000).
PAPERCLIP_REFRESH_MS=15000

# -------------------------------------------------------------------
# Hermes
# -------------------------------------------------------------------

# Required for Hermes HTTP adapter/status mode.
HERMES_ENABLED=false
HERMES_API_URL=

# Optional HTTP configuration.
HERMES_API_KEY=
HERMES_AGENT_ID=hermes-research
HERMES_CHAT_PATH=/v1/chat/completions
HERMES_TASK_PATH=/api/task
HERMES_MODEL=
HERMES_SHARED_WORKSPACE=
NEXT_PUBLIC_HERMES_URL=

# Required for Hermes chat when chat is enabled.
# Supported modes: cli, ssh, http.
HERMES_CHAT_ENABLED=false
HERMES_CHAT_MODE=cli

# Optional canonical mode override. When empty, Mika selects HTTP, then SSH,
# then CLI from complete configuration.
HERMES_CONNECTION_MODE=

# Required for CLI mode. Working directory is optional.
HERMES_CLI_COMMAND=hermes
HERMES_WORKING_DIR=

# Required for SSH mode. Remote working directory/command are optional.
HERMES_SSH_HOST=
HERMES_SSH_USER=
HERMES_SSH_KEY=
HERMES_SSH_WORKING_DIR=
HERMES_REMOTE_COMMAND=hermes

# -------------------------------------------------------------------
# Claude Code
# -------------------------------------------------------------------

# Required for the governed Claude Code adapter.
CLAUDE_CODE_ENABLED=false
CLAUDE_CODE_COMMAND=claude

# Optional: leave empty to use the application working directory.
CLAUDE_CODE_WORKING_DIR=
CLAUDE_CODE_MODE=local-cli
CLAUDE_CODE_MAX_BUDGET_USD=1.00

# Required safety mode. Supported: analysis-only-no-files, read-only-inspection.
CLAUDE_CODE_TOOL_MODE=analysis-only-no-files

# Optional alternative to an authenticated local Claude CLI session.
ANTHROPIC_API_KEY=

# -------------------------------------------------------------------
# Codex
# -------------------------------------------------------------------

# Required for the staged Codex adapter when activated through governance.
CODEX_ENABLED=false
OPENAI_API_KEY=

# -------------------------------------------------------------------
# Telegram approval bot
# -------------------------------------------------------------------

# Required for Telegram approval notifications.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_APPROVAL_CHAT_ID=

# Optional legacy/shared configuration.
TELEGRAM_CHAT_ID=
TELEGRAM_APPROVAL_CHANNEL=
TELEGRAM_WEBHOOK_SECRET=

# -------------------------------------------------------------------
# Vault and connected services
# -------------------------------------------------------------------

# Optional: prefer npm run setup, which stores the private vault location
# in config/openclaw.local.json. Leave this empty in committed examples.
VAULT_PATH=

# Optional Google integration.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Optional WhatsApp/Twilio integration.
WHATSAPP_ACCOUNT_SID=
WHATSAPP_AUTH_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_RECIPIENT=

# Optional N8N and Flowise integrations.
NEXT_PUBLIC_N8N_URL=
N8N_API_KEY=
NEXT_PUBLIC_FLOWISE_URL=
FLOWISE_API_KEY=

# -------------------------------------------------------------------
# Currently consumed media capability adapters
# -------------------------------------------------------------------

# Required for HeyGen when enabled (legacy agent-dispatch adapter — a
# different system from the HeyGen MCP integration below).
HEYGEN_ENABLED=false
HEYGEN_API_KEY=

# HeyGen Remote MCP (Checkpoint 1: OAuth connection + tool discovery only —
# no video generation, no credits consumed). Auth is OAuth through the
# user's HeyGen account via the official Remote MCP connection — there is
# NO HEYGEN_API_KEY for this path; do not add or require one. OAuth billing
# draws from the authenticated user's existing HeyGen web-plan premium
# credits, not a separate API wallet. A future, separate "Direct API"
# adapter (heygen-api, billed from its own API wallet) remains unimplemented.
# After enabling, connect with POST /api/production/providers/heygen/connect
# and complete the OAuth flow; check status at
# GET /api/production/providers/heygen/status. Custom applications may
# require HeyGen to whitelist this application's domain/redirect URI before
# authorization succeeds.
HEYGEN_MCP_ENABLED=false

# Optional: HeyGen MCP endpoint (Streamable HTTP). Defaults to the official
# endpoint below if unset.
HEYGEN_MCP_URL=https://mcp.heygen.com/mcp/v1/

# Optional: override the OAuth redirect URL sent to HeyGen. Defaults to
# <request origin>/api/production/providers/heygen/callback, derived from
# the incoming request. Set explicitly in production.
HEYGEN_MCP_OAUTH_REDIRECT_URL=

# Required for Higgsfield when enabled.
HIGGSFIELD_ENABLED=false
HIGGSFIELD_API_KEY=

# Higgsfield Remote MCP (Pre-Phase-6 Checkpoint 1: OAuth connection + tool
# discovery only — no generation, no credits consumed). Auth is OAuth
# through the user's Higgsfield account via the official Remote MCP
# connection — there is NO HIGGSFIELD_API_KEY for this path; do not add or
# require one. A future, separate "Direct API" adapter remains unimplemented
# by design (see Provider Execution Engine's providerAdapterRegistry.js).
# After enabling, connect with POST /api/production/providers/higgsfield/connect
# and complete the OAuth flow; check status at
# GET /api/production/providers/higgsfield/status. Custom applications may
# require Higgsfield to whitelist this application's domain/redirect URI
# before authorization succeeds.
HIGGSFIELD_MCP_ENABLED=false

# Optional: Higgsfield MCP endpoint (Streamable HTTP). Defaults to the
# official endpoint below if unset.
HIGGSFIELD_MCP_URL=https://mcp.higgsfield.ai/mcp

# Optional: override the OAuth redirect URL sent to Higgsfield. Defaults to
# <request origin>/api/production/providers/higgsfield/callback, derived
# from the incoming request. Set explicitly in production.
HIGGSFIELD_MCP_OAUTH_REDIRECT_URL=

# Required for OpenArt when enabled. Auth is OAuth through the user's OpenArt
# account via the official MCP connection — there is no OPENART_API_KEY.
# After enabling, connect with POST /api/openart/connect and complete the
# OAuth flow; check status at GET /api/openart/status.
OPENART_ENABLED=false

# Optional: OpenArt MCP endpoint (Streamable HTTP). Defaults to the official
# endpoint below if unset.
OPENART_MCP_URL=https://mcp.openart.ai/mcp

# Optional: override the OAuth redirect URL sent to OpenArt. Defaults to
# <request origin>/api/openart/callback, derived from the incoming request.
OPENART_OAUTH_REDIRECT_URL=

# Required for a configured Wan endpoint.
WAN_ENABLED=false
WAN_ENDPOINT=

# Required for a configured ComfyUI endpoint.
COMFYUI_ENABLED=false
COMFYUI_ENDPOINT=

# -------------------------------------------------------------------
# Reserved capability configuration
# -------------------------------------------------------------------
# These names document staged capability configuration only. The current
# runtime does not read them and setting them does not activate a tool.

# OpenRouter model routing — consumed by Fusion Review when enabled.
OPENROUTER_ENABLED=false
OPENROUTER_API_KEY=
OPENROUTER_API_URL=

# OpenRouter Fusion multi-model synthesis (sub-capability of OpenRouter).
# Set OPENROUTER_FUSION_ENABLED=true along with the keys above to activate.
OPENROUTER_FUSION_ENABLED=false
OPENROUTER_FUSION_MODEL=openrouter/fusion

# OpenRouter Content Pack Generator synthesis (sub-capability of OpenRouter,
# consumed by Studio → Content Pack). Set OPENROUTER_CONTENT_PACK_ENABLED=true
# along with OPENROUTER_ENABLED/OPENROUTER_API_KEY above to activate. Separate
# from OPENROUTER_FUSION_MODEL — content packages use a single synthesis model,
# not multi-model fusion.
OPENROUTER_CONTENT_PACK_ENABLED=false
OPENROUTER_CONTENT_MODEL=openai/gpt-4o-mini

# OpenRouter Content Workforce (sub-capability of OpenRouter, consumed by
# Creative Director → Run Creative Workforce). Set CONTENT_WORKFORCE_ENABLED=
# true along with OPENROUTER_ENABLED/OPENROUTER_API_KEY above to activate.
# Turns an approved Content Request into a complete Content Package through
# seven governed stages (Research, Script, Storyboard, Prompts, Thumbnail,
# Caption, Creative Review) — nothing is ever created in Package Pipeline
# without an explicit human approval after AI Creative Review. Separate from
# OPENROUTER_CONTENT_MODEL — the workforce uses its own dedicated model(s).
CONTENT_WORKFORCE_ENABLED=false
CONTENT_WORKFORCE_MODEL=openai/gpt-4o-mini
# Optional: model for the Creative Review stage only. Falls back to
# CONTENT_WORKFORCE_MODEL when empty.
CONTENT_WORKFORCE_REVIEW_MODEL=
CONTENT_WORKFORCE_MAX_TOKENS=2000
# Optional: provisional per-run budget cap in USD (no real per-model pricing
# is integrated — cost is a labeled provisional estimate). Leave empty for
# no cap.
CONTENT_WORKFORCE_MAX_ESTIMATED_COST=
CONTENT_WORKFORCE_STAGE_TIMEOUT_MS=45000

# Content Live Research (Phase 5, sub-capability of Content Workforce's
# Research Agent). Set CONTENT_RESEARCH_ENABLED=true to upgrade
# researchMode from "model-synthesis" to source-backed "live-search" —
# disabled means zero network calls. CONTENT_RESEARCH_PROVIDER selects
# which configured provider to use ("exa" or "tavily" have real adapters;
# "brave-search" is staged). Only ever calls ONE provider per run — never
# both, no multi-provider merge. Never activates automatically — live
# search is always an explicit user choice per run.
CONTENT_RESEARCH_ENABLED=false
CONTENT_RESEARCH_PROVIDER=exa
CONTENT_RESEARCH_ALLOW_MODEL_FALLBACK=true
CONTENT_RESEARCH_MAX_QUERIES=5
CONTENT_RESEARCH_MAX_RESULTS_PER_QUERY=5
CONTENT_RESEARCH_MAX_SOURCES=15
CONTENT_RESEARCH_MAX_FETCHES=3
CONTENT_RESEARCH_TIMEOUT_MS=30000
# Optional: provisional per-research-run budget cap in USD. Leave empty for
# no cap.
CONTENT_RESEARCH_MAX_ESTIMATED_COST=
CONTENT_RESEARCH_REQUIRE_PRIMARY_FOR_STATS=true

# Tavily (Content Live Research provider, Phase 5B). Required when
# CONTENT_RESEARCH_PROVIDER=tavily. This is Mika's OWN governed server-side
# integration (bounded search + selective extraction only — never crawl,
# map, or deep-research) — entirely independent of any Tavily MCP server
# registered in an editor, which is a separate, ungoverned, editor-scoped
# tool Mika's runtime never depends on.
TAVILY_ENABLED=false
TAVILY_API_KEY=
TAVILY_API_URL=https://api.tavily.com

# Exa search — required for the "exa" research provider when
# CONTENT_RESEARCH_ENABLED=true. Auth is a simple API key (no OAuth).
EXA_ENABLED=false
EXA_API_KEY=

# Video providers.
KLING_ENABLED=false
KLING_API_KEY=
VEO_ENABLED=false
VEO_API_KEY=
HYPERFRAMES_ENABLED=false
HYPERFRAMES_API_KEY=

# Voice provider.
ELEVENLABS_ENABLED=false
ELEVENLABS_API_KEY=

# Omi memory capture.
OMI_ENABLED=false
OMI_API_KEY=
OMI_API_URL=

# Graphify knowledge relationship mapping.
GRAPHIFY_ENABLED=false
GRAPHIFY_API_KEY=
GRAPHIFY_API_URL=

# Claw3D spatial workspace.
CLAW3D_ENABLED=false
CLAW3D_API_KEY=
CLAW3D_API_URL=

# Ruflo Swarm orchestration.
RUFLO_SWARM_ENABLED=false
RUFLO_SWARM_API_KEY=
RUFLO_SWARM_API_URL=

# NotebookLM research notebook.
NOTEBOOKLM_ENABLED=false
NOTEBOOKLM_API_KEY=
NOTEBOOKLM_API_URL=
